--- a/dist/branch.css
+++ b/dist/branch.css
@@ -53,3 +53,41 @@
   .branch-card .card-symbol { grid-column: auto; }
   .branch-exit { font-size: .78rem; padding-inline: 8px; }
 }
+
+/* REVIEW-04: Select the entire card. Keep native inputs available to keyboard and assistive technology. */
+.branch-goal,.branch-option { position:relative; min-height:58px; padding:15px 18px; transition:background-color .12s,border-color .12s; }
+.branch-goal input,.branch-option input { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
+.branch-goal:has(input:checked),.branch-option:has(input:checked) { background:var(--navy); border-color:var(--navy); color:white; }
+.branch-goal:has(input:focus-visible),.branch-option:has(input:focus-visible) { outline:3px solid #2673ce; outline-offset:3px; }
+@media(prefers-reduced-motion:reduce){.branch-goal,.branch-option{transition:none}}
+/* REVIEW-05: Make connection methods the main choices; place the score action outside the asset summary. */
+.sources-review { display:grid; gap:16px; }
+.sources-review .source-choices { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; margin-top:8px; }
+.sources-review .source-choices button { display:flex; align-items:center; justify-content:center; width:100%; min-width:0; min-height:48px; padding:12px; text-align:center; font-size:.89rem; }
+.sources-review .source-choices button[aria-pressed=true] { background:var(--navy); border-color:var(--navy); color:white; }
+.sources-review .sources-disclosure { margin-top:4px; font-size:.82rem; }
+.sources-review .sources-score { display:flex; justify-content:center; margin-top:12px; }
+.sources-review .sources-score .button { min-height:50px; min-width:min(100%,260px); }
+.sources-review .sources-summary { padding-top:16px; border-top:1px solid var(--line); }
+
+/* REVIEW-07: Center the introduction and CTA near the gap between the original explanation panels. */
+.branch-flow:has(.plans-introduction) .branch-heading { position:relative; justify-content:center; padding-inline:100px; text-align:center; }
+.branch-flow:has(.plans-introduction) .branch-heading .branch-exit { position:absolute; right:0; top:0; }
+.plans-introduction { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:24px; min-height:350px; padding-block:36px; text-align:center; }
+.plans-introduction .branch-lead { max-width:450px; margin:0; }
+.plans-introduction .actions { justify-content:center; margin:0; width:100%; }
+.plans-introduction .button { min-height:56px; min-width:min(100%,280px); font-size:1rem; padding:16px 24px; }
+@media(max-width:570px){
+ .branch-flow:has(.plans-introduction) .branch-heading { padding-inline:0; padding-top:56px; }
+ .plans-introduction { min-height:310px; padding-block:24px; }
+}
+
+/* REVIEW-08: Keep one prominent bank action and reduce alternatives to compact text buttons. */
+.sources-review .source-choices { grid-template-columns:1fr auto auto 1fr; column-gap:16px; row-gap:4px; }
+.sources-review .source-choices button[data-id="bank"] { grid-column:1 / -1; justify-content:space-between; min-height:68px; padding:20px 24px; border-radius:16px; background:var(--navy); border-color:var(--navy); color:white; font-size:1.05rem; text-align:left; }
+.sources-review .source-choices button[data-id="bank"]::after { content:"→"; font-size:1.3rem; line-height:1; }
+.sources-review .source-choices button[data-id="bank"]:hover { background:#10457f; border-color:#10457f; }
+.sources-review .source-choices button[data-id="csv"],.sources-review .source-choices button[data-id="manual"] { width:auto; min-height:44px; padding:8px 4px; border:0; border-radius:6px; background:transparent; color:var(--muted); font-size:.86rem; font-weight:600; }
+.sources-review .source-choices button[data-id="csv"] { grid-column:2; }
+.sources-review .source-choices button[data-id="manual"] { grid-column:3; }
+.sources-review .source-choices button:not([data-id="bank"]):hover,.sources-review .source-choices button:not([data-id="bank"])[aria-pressed=true] { color:var(--navy); text-decoration:underline; text-underline-offset:4px; }
